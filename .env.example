# PostgreSQL. Use the pooled URL supplied by a Vercel Marketplace integration.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/passoff?sslmode=verify-full

# Automated tests never use DATABASE_URL. Point this at an isolated,
# disposable database and explicitly confirm it before running DB-backed tests.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/passoff_test?sslmode=verify-full
PASSOFF_TEST_DATABASE_CONFIRMED=false
# Personal machines ONLY. Lets TEST_DATABASE_URL name the same database as DATABASE_URL.
# Never set this in CI or any shared environment; use a separate database or Neon branch instead.
# PASSOFF_TEST_DATABASE_SHARED_WITH_APP=true
# Run migrations against the test database instead: PASSOFF_DB_TARGET=test npm run db:migrate (or npm run db:migrate:test).
# PASSOFF_DB_TARGET=test

# Maximum connections opened by each Vercel Fluid Compute instance.
# Budget across production, previews, rolling deployments, workers, and migrations.
DATABASE_POOL_MAX=10

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional. Used only by `npm run admin:bootstrap` for an explicit one-time grant.
# Never causes automatic promotion on startup, signup, or sign-in.
# Prefer `npm run admin:grant -- --email user@example.com` for normal provisioning.
PASSOFF_BOOTSTRAP_ADMIN_EMAIL=

# Transactional email. Do not silently pick a production provider.
# test: in-memory capture for automated tests
# none: no-op for local UI work
# resend: production delivery (requires RESEND_API_KEY and EMAIL_FROM)
EMAIL_TRANSPORT=none
RESEND_API_KEY=
EMAIL_FROM=Passoff <noreply@passoff.io>

# Public site URL used for password-reset links, notification emails, and export links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Encrypts webhook signing secrets at rest. Generate a long random string.
# If unset, AUTH_SECRET is used in development. Production should set this explicitly.
PASSOFF_SECRET_ENCRYPTION_KEY=

# Protects every /api/cron/* route (webhooks, telemetry, reminders, video, workspaces, billing) and the
# detail view of /api/health. REQUIRED in production: with it blank, production refuses all cron calls.
# Vercel Cron sends Authorization: Bearer $CRON_SECRET. Use 32+ random characters.
CRON_SECRET=
# Optional. Signs the "active workspace" cookie. Falls back to AUTH_SECRET when empty.
WORKSPACE_COOKIE_SECRET=

# Public embed host for website install snippets and SDK assets.
# Use the absolute origin (no trailing slash) where /sdk/v1/passoff.js is served.
PASSOFF_EMBED_BASE_URL=https://app.example.com

# Mux Video. Keep every value server-only; never prefix these with NEXT_PUBLIC_.
# Vercel Mux integration supplies the API token pair.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Webhook signing secret from the Mux webhook endpoint (Dashboard → Webhooks).
# Required to verify POST /api/webhooks/mux. Not the API token secret.
MUX_WEBHOOK_SECRET=
# JWT signing key ID and private key for short-lived signed playback.
# Create under Mux Dashboard → Settings → Signing Keys.
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=

# OpenAI. Server-only; never prefix with NEXT_PUBLIC_.
# Used for optional website installation guidance after deterministic analysis.
OPENAI_API_KEY=
OPENAI_MODEL=

# Behavioral insights (optional). Emergency stop for visitor telemetry only.
# Review tools keep working when this is true.
PASSOFF_TELEMETRY_KILL_SWITCH=false
# HMAC key for truncated-IP abuse control and tab-session hashing.
# If unset, AUTH_SECRET is used. Rotate periodically. Never display derived values.
PASSOFF_TELEMETRY_ABUSE_KEY=
# Emergency stop for on-demand usability analysis only. Findings and issues remain.
PASSOFF_BEHAVIORAL_AI_KILL_SWITCH=false

# Billing (Stripe). See docs/BILLING.md for the full setup checklist.
# Passoff never collects card details: Stripe Checkout and the Billing Portal do.
# Server-side secret key (sk_test_... or sk_live_..., or a restricted rk_ key).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://YOUR_HOST/api/webhooks/stripe (whsec_...).
# Webhooks are the only thing that changes a workspace's plan.
STRIPE_WEBHOOK_SECRET=
# One recurring Price per plan and schedule (price_...). Amounts must match src/lib/billing/plans.ts.
# All four are required; Passoff refuses to start Checkout if one is missing or repeated.
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=
# Optional. A Billing Portal configuration (bpc_...). The Stripe default is used when empty.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
# Optional. Set to true only after Stripe Tax is configured for your account.
STRIPE_AUTOMATIC_TAX=false
# Browser tests only. Never set EMAIL_TRANSPORT=test or PASSOFF_BILLING_GATEWAY in production:
# the /api/test/* routes stay off and the startup check reports it. Uses a fake payment provider.
# PASSOFF_BILLING_GATEWAY=fake
