DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Optional: AUTH_TRUST_HOST=true

# Signed HttpOnly cookie for public reviewers (comment edit session).
# Generate with: openssl rand -base64 32
# Falls back to AUTH_SECRET in local development only; required in production.
REVIEWER_SESSION_SECRET=

# Canonical production site URL (emails, Stripe redirects, OAuth, review links, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL: {NEXT_PUBLIC_SITE_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Private Vercel Blob store (required in production)
BLOB_READ_WRITE_TOKEN=

# Create an OAuth app at https://www.figma.com/developers/apps and select
# file_content:read. Register the callback URL exactly as written here.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:3000/api/integrations/figma/callback

# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
FIGMA_TOKEN_ENCRYPTION_KEY=
PASSOFF_FIGMA_PLUGIN_KEY=

# Local directory for plugin preview PNGs (local development only)
# PASSOFF_PREVIEW_STORAGE_DIR=.data/figma-previews

# Server-side contextual analysis. OPENAI_MODEL is optional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Seeded owner workspace (development). New signups never join this workspace.
PASSOFF_DEFAULT_ORGANIZATION_SLUG=passoff
PASSOFF_DEFAULT_WORKSPACE_SLUG=main
PASSOFF_DEFAULT_PROJECT_SLUG=agent-website
PASSOFF_DEFAULT_USER_EMAIL=owner@example.com

# Fictional Harbor & Co. demo room (dev/staging). Refuses production unless override is set.
# PASSOFF_DEMO_PROJECT_SLUG=harbor-website-demo
# PASSOFF_ALLOW_DEMO_SEED=1
# CONFIRM_DEMO_RESEED=1
# PASSOFF_ALLOW_REMOTE_LOCAL_ASSETS=1

# Local filesystem asset adapter (local development only — never used in production)
# PASSOFF_ROOM_ASSET_DIR=.data/room-assets

# Transactional email via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pass-Off <onboarding@resend.dev>

# Vercel Cron — Authorization: Bearer ${CRON_SECRET}
# Schedules in vercel.json use UTC.
CRON_SECRET=
# Legacy alias still accepted by /api/internal/outbox
PASSOFF_CRON_SECRET=

# Stripe billing (Solo only in first release)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
